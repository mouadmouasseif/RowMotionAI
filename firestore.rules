rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function isActive() { return isSignedIn() && profile().active == true; }
    function isSuperAdmin() { return isActive() && profile().role in ["SUPER_ADMIN", "superadmin", "super_admin"]; }
    function isFederationPresident() { return isActive() && profile().role in ["FEDERATION_PRESIDENT", "federation_president", "president_federation"]; }
    function isTechnicalDirector() { return isActive() && profile().role in ["TECHNICAL_DIRECTOR", "technical_director", "directeur_technique"]; }
    function isClubAdmin() { return isActive() && profile().role in ["CLUB_ADMIN", "club_admin", "clubadmin"]; }
    function isCoach() { return isActive() && profile().role in ["COACH", "coach"]; }
    function isAthlete() { return isActive() && profile().role in ["ATHLETE", "athlete"]; }
    function isJury() { return isActive() && profile().role in ["JURY", "jury"]; }
    function isOwnUser(userId) { return isSignedIn() && request.auth.uid == userId; }
    function sameClub(clubId) { return isActive() && clubId != null && profile().clubId == clubId; }
    function inTechnicalScope(clubId) {
      return (isTechnicalDirector() || isFederationPresident())
        && clubId != null
        && (
          profile().technicalScope.type == "FEDERATION"
          ||
          (profile().technicalScope.type == "CLUB" && clubId in profile().technicalScope.clubIds)
          || (profile().clubId == clubId)
        );
    }
    function assignedAthlete(data) { return isCoach() && data.role in ["ATHLETE", "athlete"] && data.coachId == request.auth.uid; }
    function assignedCompetition(data) {
      return isJury() && (
        data.juryIds.hasAny([request.auth.uid])
        || data.juryId == request.auth.uid
        || data.assignedJuryIds.hasAny([request.auth.uid])
      );
    }
    function ownsAnalysis(data) {
      return data.athleteId == request.auth.uid || data.createdBy == request.auth.uid || data.coachId == request.auth.uid;
    }
    function canReadAnalysis(data) {
      return isActive() && (
        isSuperAdmin()
        || ownsAnalysis(data)
        || sameClub(data.clubId)
        || inTechnicalScope(data.clubId)
      );
    }

    match /users/{userId} {
      allow create: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.uid == userId
        && request.resource.data.role in ["ATHLETE", "COACH", "CLUB_ADMIN"];

      allow read: if isOwnUser(userId)
        || isSuperAdmin()
        || (isActive() && (
          assignedAthlete(resource.data)
          || sameClub(resource.data.clubId)
          || inTechnicalScope(resource.data.clubId)
          || (isAthlete() && profile().coachId == userId && resource.data.role == "COACH")
        ));

      allow update: if isSuperAdmin()
        || (isClubAdmin() && sameClub(resource.data.clubId)
          && request.resource.data.role == resource.data.role
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.email == resource.data.email
          && request.resource.data.clubId == resource.data.clubId)
        || (isCoach() && assignedAthlete(resource.data)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "officialCategory", "categoryOverrideReason", "categoryOverrideBy",
            "disciplines", "primaryDiscipline", "sportStatus", "updatedAt"
          ]))
        || (isOwnUser(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "firstName", "lastName", "displayName", "phone", "photoURL", "profilePhotoUrl",
            "birthDate", "trainingStartYear", "specialty", "category", "calculatedCategory",
            "level", "height", "weight", "gender", "disciplines", "primaryDiscipline",
            "nationality", "dominantSide", "privacySettings", "sportStatus", "qrCodeId",
            "onboardingCompleted", "updatedAt"
          ]));
      allow delete: if isSuperAdmin();
    }

    match /clubs/{clubId} {
      allow read: if isSuperAdmin() || sameClub(clubId) || inTechnicalScope(clubId);
      allow create, delete: if isSuperAdmin();
      allow update: if isSuperAdmin() || (isClubAdmin() && sameClub(clubId));
    }

    match /coachInvitations/{invitationId} {
      allow read: if isSuperAdmin()
        || (isClubAdmin() && sameClub(resource.data.clubId));
      allow create: if isSuperAdmin()
        || (isClubAdmin()
          && request.resource.data.clubId == profile().clubId
          && request.resource.data.requestedBy == request.auth.uid
          && request.resource.data.status == "pending_admin_sdk");
      allow update, delete: if isSuperAdmin();
    }

    match /analyses/{analysisId} {
      allow create: if isActive()
        && request.resource.data.createdBy == request.auth.uid
        && (
          request.resource.data.athleteId == request.auth.uid
          || isCoach()
          || isClubAdmin()
          || isTechnicalDirector()
          || isSuperAdmin()
        );
      allow read: if canReadAnalysis(resource.data);
      allow update: if isSuperAdmin()
        || (isCoach() && ownsAnalysis(resource.data))
        || (isClubAdmin() && sameClub(resource.data.clubId))
        || (isTechnicalDirector() && inTechnicalScope(resource.data.clubId))
        || (isActive() && resource.data.createdBy == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "videoUrl", "storagePath", "videoStorageMode", "fileName",
            "durationSeconds", "status", "progress", "updatedAt",
            "metrics", "technicalScore", "errors", "recommendations",
            "metricsSource", "cadenceTimeline"
          ]));
      allow delete: if isSuperAdmin()
        || resource.data.createdBy == request.auth.uid
        || (isClubAdmin() && sameClub(resource.data.clubId));
    }

    match /analyses/{analysisId}/{document=**} {
      allow read: if canReadAnalysis(get(/databases/$(database)/documents/analyses/$(analysisId)).data);
      allow write: if isSuperAdmin()
        || isCoach()
        || (isClubAdmin() && sameClub(get(/databases/$(database)/documents/analyses/$(analysisId)).data.clubId))
        || (isTechnicalDirector() && inTechnicalScope(get(/databases/$(database)/documents/analyses/$(analysisId)).data.clubId));
    }

    match /technicalDirectors/{directorId} {
      allow read: if isSuperAdmin() || request.auth.uid == resource.data.userId || inTechnicalScope(resource.data.clubIds[0]);
      allow create, update, delete: if isSuperAdmin();
    }

    match /competitions/{competitionId} {
      allow read: if isSuperAdmin()
        || sameClub(resource.data.clubId)
        || inTechnicalScope(resource.data.clubId)
        || assignedCompetition(resource.data);
      allow create: if isSuperAdmin() || isClubAdmin() || isCoach() || isTechnicalDirector();
      allow update, delete: if isSuperAdmin()
        || (isClubAdmin() && sameClub(resource.data.clubId))
        || (isTechnicalDirector() && inTechnicalScope(resource.data.clubId))
        || (isCoach() && resource.data.createdBy == request.auth.uid);
    }

    match /juryAssignments/{assignmentId} {
      allow read: if isSuperAdmin()
        || (isJury() && resource.data.juryId == request.auth.uid)
        || sameClub(resource.data.clubId);
      allow create, update, delete: if isSuperAdmin() || (isClubAdmin() && sameClub(request.resource.data.clubId));
    }

    match /results/{resultId} {
      allow read: if isActive();
      allow create, update: if isSuperAdmin() || isClubAdmin() || isCoach() || isJury();
      allow delete: if isSuperAdmin() || isClubAdmin();
    }

    match /notifications/{notificationId} {
      allow read, update, delete: if isActive() && (resource.data.userId == request.auth.uid || isSuperAdmin());
      allow create: if isActive();
    }

    match /messages/{messageId} {
      allow read, update: if isActive() && request.auth.uid in resource.data.participantIds;
      allow create: if isActive() && request.auth.uid in request.resource.data.participantIds;
      allow delete: if isSuperAdmin();
    }

    match /trainingPlans/{documentId} {
      allow read: if isSuperAdmin() || sameClub(resource.data.clubId) || inTechnicalScope(resource.data.clubId) || resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid;
      allow write: if isSuperAdmin() || isClubAdmin() || isCoach() || isTechnicalDirector();
    }
    match /trainingSessions/{documentId} {
      allow read: if isSuperAdmin() || sameClub(resource.data.clubId) || inTechnicalScope(resource.data.clubId) || resource.data.athleteId == request.auth.uid || resource.data.coachId == request.auth.uid;
      allow write: if isSuperAdmin() || isClubAdmin() || isCoach() || isTechnicalDirector();
    }
    match /{collectionName}/{documentId} {
      allow read: if collectionName in [
        "athletes", "coaches", "clubs", "exercises", "competitionEntries",
        "records", "physicalTests", "technicalEvaluations", "groups"
      ] && isActive() && (isSuperAdmin() || sameClub(resource.data.clubId) || inTechnicalScope(resource.data.clubId) || resource.data.userId == request.auth.uid);
      allow write: if isSuperAdmin()
        || (isClubAdmin() && sameClub(request.resource.data.clubId))
        || (isTechnicalDirector() && inTechnicalScope(request.resource.data.clubId));
    }

    match /qrProfiles/{qrCodeId} {
      allow read: if resource.data.privacySettings.qrEnabled == true;
      allow create, update: if isSignedIn() && request.auth.uid == request.resource.data.athleteId;
      allow delete: if isSignedIn() && request.auth.uid == resource.data.athleteId;
    }
    match /auditLogs/{logId} { allow read: if isSuperAdmin(); allow write: if false; }
    match /{document=**} { allow read, write: if isSuperAdmin(); }
  }
}
